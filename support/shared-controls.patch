--- /dev/null
+++ b/stream-gain.h
@@ -0,0 +1,18 @@
+/* GPL-3.0-or-later. Stream-only attenuation lease; never changes mixer/phone.
+ * Header-only policy is also compiled by the isolated C unit test. */
+#ifndef STATION_STREAM_GAIN_H
+#define STATION_STREAM_GAIN_H
+#include <stdint.h>
+typedef struct { unsigned percent; uint64_t expires_ms; } stream_gain_lease;
+static inline int stream_gain_update(stream_gain_lease *s, unsigned percent,
+                                     unsigned lease_ms, uint64_t now_ms) {
+  if (percent > 100 || lease_ms > 5000 || (percent < 100 && lease_ms == 0)) return 0;
+  s->percent = percent;
+  s->expires_ms = percent == 100 ? 0 : now_ms + lease_ms;
+  return 1;
+}
+static inline int stream_gain_fixed(stream_gain_lease *s, uint64_t now_ms) {
+  if (s->expires_ms == 0 || now_ms >= s->expires_ms) return 65536;
+  return (int)((uint64_t)s->percent * 65536 / 100);
+}
+#endif
