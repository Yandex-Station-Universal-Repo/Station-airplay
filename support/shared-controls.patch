+#include "stream-gain.h"
+#include <stdatomic.h>
+static pthread_mutex_t stream_gain_mutex = PTHREAD_MUTEX_INITIALIZER;
+static stream_gain_lease stream_gain = {100, 0};
+static atomic_int stream_gain_effective = ATOMIC_VAR_INIT(65536);
+static uint64_t stream_gain_now(void) {
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  return (uint64_t)now.tv_sec * 1000 + (uint64_t)now.tv_nsec / 1000000;
+}
+int station_set_stream_gain(unsigned percent, unsigned lease_ms) {
+  pthread_mutex_lock(&stream_gain_mutex);
+  int result = stream_gain_update(&stream_gain, percent, lease_ms, stream_gain_now());
+  pthread_mutex_unlock(&stream_gain_mutex);
+  return result;
+}
+static void station_refresh_stream_gain(void) {
+  pthread_mutex_lock(&stream_gain_mutex);
+  atomic_store_explicit(&stream_gain_effective, stream_gain_fixed(&stream_gain, stream_gain_now()), memory_order_relaxed);
+  pthread_mutex_unlock(&stream_gain_mutex);
+}
