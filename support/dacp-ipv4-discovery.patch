--- /dev/null
+++ b/dacp_endpoint.h
@@ -0,0 +1,37 @@
+/* Exact-session DACP DNS-SD identity helpers. No peer scan or stored endpoint. */
+#pragma once
+#include <arpa/inet.h>
+#include <ctype.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static inline int dacp_service_name(const char *id, char *out, size_t capacity) {
+  if (!id || !*id || strlen(id) > 16 || capacity < 29) return 0;
+  char canonical[17];
+  memset(canonical, '0', 16); canonical[16] = 0;
+  size_t length = strlen(id);
+  for (size_t i = 0; i < length; i++) {
+    unsigned char c = (unsigned char)id[i];
+    if (!isxdigit(c)) return 0;
+    canonical[16-length+i] = (char)toupper(c);
+  }
+  return snprintf(out, capacity, "iTunes_Ctrl_%s", canonical) == 28;
+}
+
+static inline int dacp_same_id(const char *a, const char *b) {
+  char left[29], right[29];
+  return dacp_service_name(a, left, sizeof left) &&
+      dacp_service_name(b, right, sizeof right) && strcmp(left, right) == 0;
+}
+
+static inline int dacp_service_matches(const char *name, const char *id) {
+  return name && strncmp(name, "iTunes_Ctrl_", 12) == 0 && dacp_same_id(name+12, id);
+}
+
+static inline int dacp_unicast_ipv4(const char *address, uint16_t port) {
+  struct in_addr parsed;
+  if (!port || !address || inet_pton(AF_INET, address, &parsed) != 1) return 0;
+  uint32_t value = ntohl(parsed.s_addr);
+  return (value >> 24) != 0 && (value >> 24) != 127 && (value >> 24) < 224;
+}
