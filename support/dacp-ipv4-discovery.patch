+// RemoteControl.Available describes classic DACP only. Modern AirPlay 2 already
+// has upstream command/volume transport over the paired event channel. Report
+// the actual live channel, not merely the compiled protocol or stream Active.
+static gboolean on_handle_get_control_status(ShairportSync *skeleton,
+    GDBusMethodInvocation *invocation, __attribute__((unused)) gpointer user_data) {
+  gboolean available = FALSE;
+  char client[INET6_ADDRSTRLEN] = "";
+#ifdef CONFIG_AIRPLAY_2
+  pthread_rwlock_rdlock(&principal_conn_lock);
+  if (principal_conn && principal_conn->airplay_type == ap_2) {
+    pthread_mutex_lock(&principal_conn->event_sender_mutex);
+    available = principal_conn->event_channel_fd > 0;
+    if (available)
+      snprintf(client, sizeof(client), "%s", principal_conn->client_ip_string);
+    pthread_mutex_unlock(&principal_conn->event_sender_mutex);
+  }
+  pthread_rwlock_unlock(&principal_conn_lock);
+#endif
+  shairport_sync_complete_get_control_status(skeleton, invocation, 1, available, client);
   return TRUE;
 }
 
