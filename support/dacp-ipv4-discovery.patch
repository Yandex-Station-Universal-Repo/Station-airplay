+// The RTSP socket may use IPv6 while the sender's actual DACP service is IPv4.
+// Adopt only an exact current-session DNS-SD identity, never an arbitrary peer.
+// Availability is still established by the existing authenticated HTTP probe.
+void dacp_monitor_ipv4_endpoint_callback(const char *dacp_id, const char *address, uint16_t port) {
+  if (!dacp_unicast_ipv4(address, port)) return;
+  pthread_mutex_lock(&dacp_server_information_lock);
+  if (dacp_same_id(dacp_id, dacp_server.dacp_id) && dacp_server.active_remote_id) {
+    dacp_server.connection_family = AF_INET;
+    dacp_server.scope_id = 0;
+    snprintf(dacp_server.ip_string, sizeof(dacp_server.ip_string), "%s", address);
+    dacp_server.port = port;
+    dacp_server.scan_enable = 1;
+    pthread_cond_signal(&dacp_server_information_cv);
+  }
+  pthread_mutex_unlock(&dacp_server_information_lock);
+}
